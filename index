            <p className={`text-xs font-semibold mb-2 p-2 rounded-lg break-keep ${isEligible?'bg-slate-50 text-slate-700':'bg-rose-50 text-rose-700 border border-rose-100'}`}>{summary}</p>
            <div className="flex flex-wrap gap-1.5">
              <span className="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded text-slate-600">성과: {details.perf} {isUpwardTrend && <span className="text-sky-600">(우상향 +10)</span>}</span>
              <span className="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded text-sky-600">직무: {details.jobPerform}</span>
              <span className="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded text-sky-600">포상: {details.awards}</span>
              {details.underC < 0 && <span className="text-[10px] font-bold bg-rose-50 border border-rose-200 px-2 py-0.5 rounded text-rose-600">연속저평가: -10</span>}
              <span className="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded text-emerald-600">태도/제도: {details.collab + details.attendance}</span>
              {details.penalty > 0 && <span className="text-[10px] font-bold bg-rose-50 border border-rose-200 px-2 py-0.5 rounded text-rose-600">징계: -30</span>}
              <span className="text-[10px] font-bold bg-sky-50 border border-sky-200 px-2 py-0.5 rounded text-sky-700">가점: {details.culture+details.knowledge+details.leader+details.tf+details.instructor+details.mentoring+details.cert+details.specialist}</span>
            </div>
          </div>
          <div className="w-full lg:w-28 flex-shrink-0 pl-0 lg:pl-4 border-l-0 lg:border-l border-slate-100">
            <div className={`text-center py-2 rounded-lg text-xs font-black border-2 flex items-center justify-center gap-1 ${!isEligible?'bg-rose-50 border-rose-500 text-rose-700':isPassed?'bg-sky-50 border-sky-500 text-sky-700':'bg-slate-50 border-slate-200 text-slate-500'}`}>
              {!isEligible && <AlertTriangle className="w-3 h-3" />} {!isEligible?'대상 제외':isPassed?'승급 유력':'점수 미달'}
            </div>
          </div>
        </div>
      );
    };

    return (
      <div className="animate-in fade-in duration-500 space-y-6">
        <div className="flex justify-center md:justify-start">
          <div className="flex bg-white p-1.5 rounded-xl border border-slate-200 shadow-sm">
            <button onClick={() => setPromoTab('registration')} className={`px-6 py-2 text-sm font-bold rounded-lg transition-all ${promoTab === 'registration' ? 'bg-sky-50 text-sky-700' : 'text-slate-500 hover:text-slate-800'}`}>1. 승급 대상자 등록</button>
            <button onClick={() => setPromoTab('report')} className={`px-6 py-2 text-sm font-bold rounded-lg transition-all ${promoTab === 'report' ? 'bg-sky-50 text-sky-700' : 'text-slate-500 hover:text-slate-800'}`}>2. AI 승급 리포트</button>
          </div>
        </div>
        {promoTab === 'registration' && renderCandidateRegBox("promotion")}
        {promoTab === 'report' && (
          <div className="bg-white/80 backdrop-blur-xl rounded-2xl shadow-sm border border-slate-200 overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500">
            <div className="bg-gradient-to-r from-sky-50 to-white border-b border-slate-200 px-6 py-5 flex items-center justify-between"><div className="flex items-center gap-3"><div className="bg-sky-100 p-2 rounded-xl text-sky-600"><Award className="w-5 h-5" /></div><h2 className="text-xl font-bold text-slate-800">AI 승급 심사 리포트</h2></div></div>
            <div className="p-6">
              {analyzedPromo.length === 0 ? (
                <div className="text-center py-20 bg-slate-50/80 rounded-2xl border-2 border-slate-200 border-dashed">
                   <div className="bg-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-5 shadow-sm border border-slate-200"><TrendingUp className="w-7 h-7 text-sky-500" /></div>
                   <h3 className="text-xl font-black text-slate-800 mb-2">승급 분석 준비 완료</h3>
                   <button onClick={handleRunAnalysisLocal} className="bg-sky-600 text-white px-10 py-4 rounded-full font-bold shadow-lg hover:bg-sky-700 mt-6 flex items-center gap-2.5 mx-auto"><PlayCircle className="w-6 h-6" /> 분석 시작</button>
                 </div>
              ) : (
                <div className="space-y-8">
                  <div className="flex justify-between items-center mb-2">
                    <span className="text-sm font-bold text-sky-900">총 {analyzedPromo.length}명 심사 결과</span>
                    <button onClick={handleRunAnalysisLocal} className="text-xs font-bold text-sky-700 bg-sky-50 px-3 py-1.5 rounded-lg border border-sky-200 hover:bg-sky-100">↻ 갱신</button>
                  </div>
                  {['B2(5) 이하 (실무자)', 'B3(6) 이상 (리더)'].map((groupTitle, gIdx) => {
                    const group = analyzedPromo.filter(c => gIdx === 0 ? BAND_LEVELS[c.band] <= 4 : BAND_LEVELS[c.band] >= 5);
                    if(group.length === 0) return null;
                    return (
                      <div key={groupTitle} className={gIdx===1 ? "pt-6 border-t border-slate-200" : ""}>
                        <h4 className={`text-sm font-bold mb-3 flex items-center gap-2 border-b border-slate-200 pb-2 ${gIdx===0?'text-sky-800':'text-sky-800'}`}>
                          <span className={`px-2.5 py-1 rounded-md text-xs ${gIdx===0?'bg-sky-100 text-sky-700':'bg-sky-200 text-sky-800'}`}>{groupTitle} 타겟</span>
                          승급 심사 명단
                        </h4>
                        <div className="space-y-4">
                          {group.map((cand, idx) => renderPromoCard(cand, idx))}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    );
  };

  const renderLeaderTabContent = () => (
    <div className="animate-in fade-in duration-500 space-y-6">
      <div className="flex justify-center md:justify-start">
        <div className="flex bg-white p-1.5 rounded-xl border border-slate-200 shadow-sm">
          <button onClick={() => setLeaderTab('registration')} className={`px-6 py-2 text-sm font-bold rounded-lg transition-all ${leaderTab === 'registration' ? 'bg-sky-50 text-sky-700' : 'text-slate-500 hover:text-slate-800'}`}>1. 직책자 후보 등록</button>
          <button onClick={() => setLeaderTab('report')} className={`px-6 py-2 text-sm font-bold rounded-lg transition-all ${leaderTab === 'report' ? 'bg-sky-50 text-sky-700' : 'text-slate-500 hover:text-slate-800'}`}>2. AI 추천 리포트</button>
        </div>
      </div>
      {leaderTab === 'registration' && (
        <div className="space-y-6">
          <div className="bg-white/80 backdrop-blur-xl rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-4">
            <div className="bg-gradient-to-r from-sky-50 to-white border-b border-slate-200 px-5 py-3 flex items-center justify-between">
              <div className="flex items-center gap-2"><div className="bg-sky-100 p-1.5 rounded-lg text-sky-600"><UserCheck className="w-4 h-4" /></div><h2 className="text-lg font-bold text-slate-800">직책자 필요 부서 및 선호 유형 설정</h2></div>
            </div>
            <div className="p-5 grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <label className="block text-xs font-bold text-slate-600 mb-2">타겟 본부</label>
                <select value={leaderTargetHQ} onChange={(e) => {setLeaderTargetHQ(e.target.value); setLeaderTargetDept(getDeptList(e.target.value)[0]);}} className="w-full border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none cursor-pointer focus:border-sky-500">{Object.keys(JOB_DATABASE).map(hq => <option key={hq} value={hq}>{hq}</option>)}</select>
              </div>
              <div>
                <label className="block text-xs font-bold text-slate-600 mb-2">타겟 부서 (주요직무 경험 매칭용)</label>
                <select value={leaderTargetDept} onChange={(e) => setLeaderTargetDept(e.target.value)} className="w-full border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none cursor-pointer focus:border-sky-500">{getDeptList(leaderTargetHQ).map(d => <option key={d} value={d}>{d}</option>)}</select>
              </div>
              <div>
                <label className="block text-xs font-bold text-slate-600 mb-2">선호 리더십 유형</label>
                <select value={prefLeaderType} onChange={(e) => setPrefLeaderType(e.target.value)} className="w-full border border-sky-300 rounded-lg p-2 text-sm font-bold outline-none cursor-pointer bg-sky-50 text-sky-800 focus:border-sky-500">{LEADER_STYLES.map(s => <option key={s} value={s}>{s}</option>)}</select>
              </div>
            </div>
          </div>
          {renderCandidateRegBox("leadership")}
        </div>
      )}
      {leaderTab === 'report' && (
        <div className="bg-white/80 backdrop-blur-xl rounded-2xl shadow-sm border border-slate-200 overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500">
          <div className="bg-gradient-to-r from-sky-50 to-white border-b border-slate-200 px-6 py-5 flex items-center justify-between"><div className="flex items-center gap-3"><div className="bg-sky-100 p-2 rounded-xl text-sky-600"><Award className="w-5 h-5" /></div><h2 className="text-xl font-bold text-slate-800">AI 직책자 추천 리포트</h2></div></div>
          <div className="p-6">
            {analyzedLeader.length === 0 ? (
              <div className="text-center py-20 bg-slate-50/80 rounded-2xl border-2 border-slate-200 border-dashed">
                 <div className="bg-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-5 shadow-sm border border-slate-200"><UserCheck className="w-7 h-7 text-sky-500" /></div>
                 <h3 className="text-xl font-black text-slate-800 mb-2">분석 준비 완료</h3>
                 <div className="flex flex-col items-center gap-3 mt-6">
                   <div className="flex flex-wrap gap-2 justify-center max-w-lg min-h-[32px]">
                     {leaderJobFilters.map(f => (
                       <span key={f} className="bg-sky-100 text-sky-800 px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-sm">
                         {f} <button onClick={() => setLeaderJobFilters(prev => prev.filter(item => item !== f))} className="hover:text-sky-900"><XCircle className="w-3.5 h-3.5" /></button>
                       </span>
                     ))}
                   </div>
                   <select value="" onChange={e=>{ if(e.target.value && !leaderJobFilters.includes(e.target.value)) setLeaderJobFilters(p=>[...p, e.target.value]); }} className="bg-white border border-slate-300 rounded-lg px-4 py-2 text-sm font-bold text-slate-700 outline-none shadow-sm cursor-pointer focus:border-sky-500 hover:border-sky-300">
                     <option value="">+ 필수 경험 직무 추가 (다중 선택 가능)</option>
                     {ALL_UNIQUE_JOB_TITLES.map(t => <option key={t} value={t}>{t}</option>)}
                   </select>
                   <button onClick={handleRunAnalysisLocal} className="bg-sky-600 text-white px-10 py-4 rounded-full font-bold shadow-lg hover:bg-sky-700 flex items-center gap-2.5 mt-2">
                     <PlayCircle className="w-6 h-6" /> 추천 시작
                   </button>
                 </div>
               </div>
            ) : (
              <div className="space-y-4">
                <div className="flex flex-col md:flex-row md:justify-between md:items-center mb-4 gap-3">
                  <div className="flex flex-col gap-1.5">
                      <span className="text-sm font-bold text-sky-900">추천 리스트 (100점 만점)</span>
                      {leaderJobFilters.length > 0 && (
                          <div className="flex flex-wrap gap-1.5">
                              {leaderJobFilters.map(f => (
                              <span key={f} className="bg-white border border-sky-200 text-sky-700 px-2 py-0.5 rounded-md text-[10px] font-bold flex items-center gap-1 shadow-sm">
                                  {f} <button onClick={() => setLeaderJobFilters(prev => prev.filter(item => item !== f))} className="hover:text-sky-900"><XCircle className="w-3 h-3" /></button>
                              </span>
                              ))}
                          </div>
                      )}
                  </div>
                  <div className="flex items-center gap-2">
                    <select value="" onChange={e=>{ if(e.target.value && !leaderJobFilters.includes(e.target.value)) setLeaderJobFilters(p=>[...p, e.target.value]); }} className="bg-white border border-sky-200 rounded-lg px-3 py-1.5 text-xs font-bold text-sky-800 outline-none cursor-pointer">
                      <option value="">+ 필터 추가</option>
                      {ALL_UNIQUE_JOB_TITLES.map(t => <option key={t} value={t}>{t}</option>)}
                    </select>
                    <button onClick={handleRunAnalysisLocal} className="text-xs font-bold text-sky-700 bg-sky-50 px-3 py-1.5 rounded-lg border border-sky-200 hover:bg-sky-100">↻ 갱신</button>
                  </div>
                </div>
                {analyzedLeader.map((cand, idx) => {
                  const { total, details, summary, isRecommended, evals, inferredStyle } = cand.evaluation;
                  return (
                    <div key={cand.id} className={`relative flex flex-col lg:flex-row items-center border-2 rounded-xl p-4 gap-4 bg-white shadow-sm transition-all ${isRecommended ? 'border-sky-300' : 'border-slate-200'}`}>
                      <div className="flex-shrink-0 w-8 flex justify-center"><div className={`w-7 h-7 rounded-lg flex items-center justify-center font-bold text-sm ${idx===0?'bg-sky-500 text-white shadow-md': 'bg-slate-100 text-slate-500'}`}>{idx+1}</div></div>
                      <div className="w-full lg:w-48 flex flex-col border-b lg:border-b-0 lg:border-r border-slate-100 pb-3 lg:pb-0 lg:pr-4">
                        <div className="flex justify-between items-center mb-1"><h3 className="text-lg font-black text-slate-800">{cand.name}</h3><span className={`text-2xl font-black ${isRecommended ? 'text-sky-600' : 'text-slate-500'}`}>{total}</span></div>
                        <p className="text-xs font-bold text-slate-500 mb-2">{cand.currentDept} | {cand.band}</p>
                        <div className="flex items-end justify-between mt-1 mb-2 border-t border-slate-100 pt-2">
                           {renderSparkline([...evals].reverse())}
                           <span className={`text-[10px] font-bold px-1.5 py-0.5 rounded ${inferredStyle===prefLeaderType ? 'bg-sky-100 text-sky-800' : 'bg-slate-100 text-slate-600'}`}>{inferredStyle}</span>
                        </div>
                        <div className="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden"><div className={`h-full rounded-full ${isRecommended ? 'bg-sky-500' : 'bg-slate-400'}`} style={{ width: `${total}%` }} /></div>
                      </div>
                      <div className="w-full lg:flex-1">
                        <p className="text-xs font-semibold mb-2 p-2 rounded-lg break-keep bg-slate-50 text-slate-700">{summary}</p>
                        <div className="flex flex-wrap gap-1.5">
                          <span className="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded text-sky-600">부서경험: {details.exp}/30</span>
                          <span className="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded text-sky-600">평가추이: {details.perf}/25</span>
                          <span className="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded text-emerald-600">제도준수: {details.compliance}/15</span>
                          <span className="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded text-emerald-600">태도수시: {details.attitude}/15</span>
                          <span className="text-[10px] font-bold bg-sky-50 border border-sky-200 px-2 py-0.5 rounded text-sky-700">리더매칭: {details.leaderMatch}/15</span>
                        </div>
                      </div>
                      <div className="w-full lg:w-28 flex-shrink-0 pl-0 lg:pl-4 border-l-0 lg:border-l border-slate-100">
                        <div className={`text-center py-2 rounded-lg text-xs font-black border-2 ${isRecommended ? 'bg-sky-50 border-sky-500 text-sky-700' : 'bg-slate-50 border-slate-200 text-slate-500'}`}>
                          {isRecommended ? '추천 적합' : '보류'}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );

  return (
    <div className="min-h-screen bg-[#F4F7FA] text-slate-900 font-sans p-4 md:p-8 relative selection:bg-sky-100 selection:text-sky-900">
      <style dangerouslySetInnerHTML={{ __html: scrollbarStyle }} />
      {confirmModal.isOpen && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm animate-in fade-in duration-200">
          <div className="bg-white rounded-2xl shadow-2xl p-6 max-w-sm w-full mx-4"><div className="flex items-center gap-3 mb-3"><div className="bg-rose-100 p-2 rounded-full"><AlertCircle className="w-5 h-5 text-rose-600" /></div><h3 className="text-lg font-black text-slate-800">확인</h3></div><p className="text-sm font-medium text-slate-600 mb-6">{confirmModal.text}</p><div className="flex justify-end gap-2"><button onClick={() => setConfirmModal({isOpen: false, text: '', action: null})} className="px-5 py-2.5 text-sm font-bold text-slate-500 bg-slate-100 hover:bg-slate-200 rounded-xl">취소</button><button onClick={confirmModal.action} className="px-5 py-2.5 text-sm font-bold text-white bg-rose-500 hover:bg-rose-600 rounded-xl">확인</button></div></div>
        </div>
      )}
      {toast && (
        <div className="fixed bottom-8 right-8 bg-slate-800/95 backdrop-blur-md text-white px-6 py-4 rounded-xl shadow-2xl flex items-center gap-3 animate-in fade-in slide-in-from-bottom-5 z-50"><CheckCircle className="w-5 h-5 text-emerald-400" /><span className="font-bold text-sm tracking-wide">{toast}</span></div>
      )}

      <div className="max-w-[1400px] mx-auto space-y-6">
        <header className="bg-white/90 backdrop-blur-xl px-8 py-5 rounded-[24px] shadow-sm border border-slate-200 flex flex-col md:flex-row justify-between items-center gap-5 sticky top-4 z-40">
          <h1 className="text-2xl font-black text-slate-800 flex items-center gap-3 tracking-tight"><div className="bg-gradient-to-br from-sky-500 to-sky-700 p-2.5 rounded-2xl text-white shadow-lg"><Settings className="w-6 h-6" /></div>HR 인재추천 시스템</h1>
          <div className="flex bg-slate-100/80 p-1.5 rounded-2xl border border-slate-200 shadow-inner overflow-x-auto">
            <button onClick={() => setMainCategory('transfer')} className={`flex-shrink-0 flex items-center gap-2 px-6 py-2.5 text-sm font-extrabold rounded-xl transition-all duration-300 ${mainCategory === 'transfer' ? 'bg-white text-sky-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}><ArrowRightLeft className="w-4 h-4"/> 사내 이동</button>
            <button onClick={() => setMainCategory('promotion')} className={`flex-shrink-0 flex items-center gap-2 px-6 py-2.5 text-sm font-extrabold rounded-xl transition-all duration-300 ${mainCategory === 'promotion' ? 'bg-white text-sky-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}><TrendingUp className="w-4 h-4"/> 승급 심사</button>
            <button onClick={() => setMainCategory('leadership')} className={`flex-shrink-0 flex items-center gap-2 px-6 py-2.5 text-sm font-extrabold rounded-xl transition-all duration-300 ${mainCategory === 'leadership' ? 'bg-white text-sky-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}><UserCheck className="w-4 h-4"/> 직책자 추천</button>
          </div>
          <button onClick={handleResetAll} className="flex items-center gap-2 text-sm font-bold text-slate-400 hover:text-rose-500 px-3 py-2 bg-slate-50 rounded-xl hover:bg-rose-50" title="초기화"><RotateCcw className="w-4 h-4" /></button>
        </header>

        {mainCategory === 'transfer' && renderTransferTabContent()}
        {mainCategory === 'promotion' && renderPromoTabContent()}
        {mainCategory === 'leadership' && renderLeaderTabContent()}
      </div>
    </div>
  );
}
