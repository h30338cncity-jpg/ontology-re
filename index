    const avgPerf = ((perfMap[cand.perf2023]||3) + (perfMap[cand.perf2024]||3) + (perfMap[cand.perf2025]||3)) / 3;
    if (avgPerf >= 4.0) { score += 10; details.perf = { score: 10, label: "상(S/A)" }; }
    else if (avgPerf >= 3.0) { score += 7; details.perf = { score: 7, label: "중(B)" }; }
    else { score += 4; details.perf = { score: 4, label: "하(C이하)" }; }

    const candLevel = BAND_LEVELS[cand.band] || 4;
    const reqLevel = BAND_LEVELS[job.band] || 4;
    const bandDiff = Math.abs(candLevel - reqLevel);
    if (bandDiff === 0) { score += 10; details.band = { score: 10, label: "상(일치)" }; }
    else if (bandDiff === 1) { score += 7; details.band = { score: 7, label: "중(1단계)" }; }
    else { score += 4; details.band = { score: 4, label: "하(2단계↑)" }; }

    const isAnyMajor = job.majors.includes("전공무관");
    const matchedSpecificMajor = job.majors.find(m => m !== "전공무관" && candMajor.includes(m.replace(/\s+/g, '').toLowerCase()));
    const candCategory = getMajorCategory(candMajor);
    const jobCategories = job.majors.map(m => getMajorCategory(m));

    if (matchedSpecificMajor) { score += 5; details.major = { score: 5, label: "상(우대전공)" }; } 
    else if (candMajor.length > 0 && (isAnyMajor || jobCategories.includes(candCategory))) { score += 3.5; details.major = { score: 3.5, label: "중(유사/무관)" }; } 
    else { score += 2; details.major = { score: 2, label: "하(계열다름)" }; }

    let summary = `최근 3년 평균 성과는 ${avgPerf>=4?'우수하며':'무난하며'}, 직무로드 기준 ${details.exp.score===40?'타겟 직무와 일치하는 핵심 수행 경험을 보유하고 있습니다.':details.exp.score===28?'매칭 직무 수행 경험이 있어 원활한 직무 전환이 가능할 것으로 보입니다.':'유관 직무 경험이 부족하여 배치 시 온보딩이 요구됩니다.'}`;

    return { total: Number(score.toFixed(1)), details, summary };
  };

  // --- AI 로직 2: 승급 심사 ---
  const calculatePromotionScore = (cand) => {
    let score = 0;
    const isLeader = BAND_LEVELS[cand.band] >= 5; 
    const maxScore = isLeader ? 800 : 500;
    const d = {}; 

    const sMap = { 'S': 4.5, 'A': 4.0, 'B': 3.5, 'C': 3.0, 'D': 2.5, 'N/A': null };
    const perfPointMap = { 'S': 100, 'A': 80, 'B': 60, 'C': 40, 'D': 20, 'N/A': null };
    
    const evalData = [
      { grade: cand.perf2025, gpa: sMap[cand.perf2025], pts: perfPointMap[cand.perf2025], w5: 0.40, w3: 0.50 },
      { grade: cand.perf2024, gpa: sMap[cand.perf2024], pts: perfPointMap[cand.perf2024], w5: 0.25, w3: 0.30 },
      { grade: cand.perf2023, gpa: sMap[cand.perf2023], pts: perfPointMap[cand.perf2023], w5: 0.15, w3: 0.20 },
      { grade: cand.perf2022, gpa: sMap[cand.perf2022], pts: perfPointMap[cand.perf2022], w5: 0.10, w3: 0 },
      { grade: cand.perf2021, gpa: sMap[cand.perf2021], pts: perfPointMap[cand.perf2021], w5: 0.10, w3: 0 }
    ];

    const validGpas = evalData.slice(0, 3).map(e => e.gpa).filter(v => v !== null);
    const avg3 = validGpas.length > 0 ? Number((validGpas.reduce((a,b)=>a+b, 0) / validGpas.length).toFixed(2)) : 0;
    const perf25 = evalData[0].gpa !== null ? evalData[0].gpa : 0; 
    const tenure = calcTenure(cand.promotionDate);
    let isEligible = true;
    let failReason = "";

    if (cand.band === 'B4(8)' || cand.band === 'B3(7)') {
        if (tenure < 3) { isEligible = false; failReason = "체류연한 3년 미달"; }
        else if (perf25 < 4.0) { isEligible = false; failReason = "당해 평가 A 미달"; }
        else if (avg3 < 4.0) { isEligible = false; failReason = "유효 평가 평균 4.0 미달"; }
    } else if (cand.band === 'B3(6)') {
        if (tenure < 3) { isEligible = false; failReason = "체류연한 3년 미달"; }
        else if (perf25 < 3.5) { isEligible = false; failReason = "당해 평가 B 미달"; }
        else if (avg3 < 3.5) { isEligible = false; failReason = "유효 평가 평균 3.5 미달"; }
    } else if (cand.band === 'B2(5)') {
        if (tenure < 3) { isEligible = false; failReason = "체류연한 3년 미달"; }
        else if (perf25 < 4.0) { isEligible = false; failReason = "당해 평가 A 미달"; }
        else if (avg3 < 3.5) { isEligible = false; failReason = "유효 평가 평균 3.5 미달"; }
    } else if (cand.band === 'B2(4)') {
        if (tenure < 3) { isEligible = false; failReason = "체류연한 3년 미달"; }
        else if (perf25 < 3.5) { isEligible = false; failReason = "당해 평가 B 미달"; }
        else if (avg3 < 3.0) { isEligible = false; failReason = "유효 평가 평균 3.0 미달"; }
    } else { 
        if (tenure < 2) { isEligible = false; failReason = "체류연한 2년 미달"; }
        else if (perf25 < 4.0) { isEligible = false; failReason = "당해 평가 A 미달"; }
        else if (avg3 < 3.0) { isEligible = false; failReason = "유효 평가 평균 3.0 미달"; }
    }

    let validWeightSum = 0; let weightedPointsSum = 0;
    if (isLeader) {
      evalData.forEach(e => { if (e.pts !== null) { validWeightSum += e.w5; weightedPointsSum += (e.pts * e.w5); } });
      d.perf = validWeightSum > 0 ? (weightedPointsSum / validWeightSum) * 2.5 : 0;
    } else {
      evalData.slice(0, 3).forEach(e => { if (e.pts !== null) { validWeightSum += e.w3; weightedPointsSum += (e.pts * e.w3); } });
      d.perf = validWeightSum > 0 ? (weightedPointsSum / validWeightSum) * 2 : 0;
    }
    d.perf = Math.round(d.perf * 10) / 10;
    
    // 우상향 트렌드 감지
    let isUpwardTrend = false;
    const validGradesForTrend = evalData.map(e => e.pts).filter(v => v !== null).reverse(); 
    if (validGradesForTrend.length >= 3) {
      let upwardCount = 0;
      for (let i = 0; i < validGradesForTrend.length - 1; i++) {
        if (validGradesForTrend[i+1] > validGradesForTrend[i]) upwardCount++;
      }
      if (upwardCount >= 2) isUpwardTrend = true; 
    }
    d.trendBonus = isUpwardTrend ? 10 : 0;
    score += (d.perf + d.trendBonus);

    d.jobPerformCount = countItems(cand.jobPerformText);
    d.jobPerform = d.jobPerformCount >= (isLeader ? 2 : 1) ? 100 : 0; 
    score += d.jobPerform;

    d.awardCount = countItems(cand.awardsText);
    d.awards = Math.min(d.awardCount * 10, 30); 
    score += d.awards;
    
    const perfArray = evalData.map(e => e.grade).filter(g => g !== 'N/A');
    let isUnderC = false;
    for (let i = 0; i < perfArray.length - 1; i++) {
        if (['C', 'D'].includes(perfArray[i]) && ['C', 'D'].includes(perfArray[i+1])) { isUnderC = true; break; }
    }
    d.underC = isUnderC ? -10 : 0; 
    score += d.underC;

    d.collab = Number(cand.collab) || 0; score += d.collab; 
    d.attendance = Math.max(50 - ((Number(cand.tardyCount) || 0) * 10), 0); score += d.attendance;
    d.penalty = hasText(cand.penaltyText) ? 30 : 0; score -= d.penalty; 

    d.culture = Number(cand.culture) || 0; score += d.culture; 
    d.knowledge = hasText(cand.knowledgeText) ? (isLeader ? 50 : 10) : 0; score += d.knowledge;
    d.leader = hasText(cand.leaderText) ? (isLeader ? 50 : 15) : 0; score += d.leader;
    d.tf = hasText(cand.tfText) ? (isLeader ? 40 : 10) : 0; score += d.tf;
    d.instructor = hasText(cand.instructorText) ? (isLeader ? 30 : 10) : 0; score += d.instructor;
    d.mentoring = hasText(cand.mentoringText) ? (isLeader ? 30 : 10) : 0; score += d.mentoring;
    d.cert = hasText(cand.certText) ? (isLeader ? 30 : 10) : 0; score += d.cert;
    d.specialist = hasText(cand.specialistText) ? (isLeader ? 20 : 10) : 0; score += d.specialist;

    let summary = '';
    if (!isEligible) { summary = `[기본 조건 불충족] 사유: ${failReason}. 체류연한 ${tenure}년 및 유효 평균 ${avg3}점.`; score = 0; } 
    else { summary = `[기본 조건 통과] 체류연한 ${tenure}년, 유효 평균 ${avg3}점. 주요성과 ${d.jobPerformCount}건 반영됨.`; }

    return { score: Math.round(score), maxScore, details: d, summary, isLeader, isEligible, failReason, tenure, isUpwardTrend, evals: evalData.map(e => e.grade) };
  };

  // --- AI 로직 3: 직책자 추천 ---
  const calculateLeaderScore = (cand) => {
    let score = 0; const d = {};

    const deptJobs = JOB_DATABASE[leaderTargetHQ]?.filter(j => j.dept === leaderTargetDept).map(j => j.title.replace(/\s+/g, '').toLowerCase()) || [];
    const cleanExp = (cand.experience || '').replace(/\s+/g, '').toLowerCase();
    const hasDeptExp = deptJobs.some(j => cleanExp.includes(j));
    d.exp = hasDeptExp ? 30 : 10;
    score += d.exp;

    const sMap = { 'S': 5, 'A': 4, 'B': 3, 'C': 2, 'D': 1, 'N/A': null };
    const evalData = [cand.perf2025, cand.perf2024, cand.perf2023, cand.perf2022, cand.perf2021];
    const evals = evalData.map(v => sMap[v]).filter(v => v !== null);
    let evalScore = 0; let isUpward = false;
    if (evals.length > 0) {
      const avg = evals.reduce((a,b)=>a+b, 0) / evals.length; 
      evalScore = (avg / 5) * 20; 
      
      const chronological = [...evals].reverse();
      if (chronological.length >= 3) {
          let upCnt = 0;
          for(let i=0; i<chronological.length-1; i++) { if(chronological[i+1] > chronological[i]) upCnt++; }
          if(upCnt >= 2) isUpward = true;
      }
    }
    d.perf = Math.round(evalScore + (isUpward ? 5 : 0));
    score += d.perf;

    let compScore = 0;
    if (Number(cand.vacationRate) >= 80) compScore += 5;
    if (Number(cand.tardyCount) === 0) compScore += 5;
    if ((Number(cand.overtime) || 0) <= 40) compScore += 5; 
    if (hasText(cand.penaltyText)) compScore -= 15; 
    d.compliance = Math.max(0, compScore);
    score += d.compliance;

    const attitudeSum = Object.values(cand.evalScores || {}).reduce((a,b)=>a+Number(b), 0);
    d.attitude = Math.round((attitudeSum / 100) * 15);
    score += d.attitude;

    const inferredStyle = inferLeadershipStyle(cand.evalScores);
    d.leaderMatch = (inferredStyle === prefLeaderType) ? 15 : 5;
    score += d.leaderMatch;

    const total = Math.min(score, 100);
    const isRecommended = total >= 80;
    const summary = `[${leaderTargetDept}] 직무 경험 ${hasDeptExp ? '보유(적합)' : '부족'}. 5년 평가 ${isUpward ? '우상향 추세' : '무난'}. AI 리더십 추론 결과 [${inferredStyle}] 성향으로 분석되어, 선호 유형(${prefLeaderType})과 ${inferredStyle === prefLeaderType ? '일치함' : '불일치함'}.`;

    return { total, details: d, summary, isRecommended, inferredStyle, evals: evalData };
  };

  // --- 이벤트 핸들러 (제출 및 등록) ---
