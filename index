    const coreExpKeywords = job.keywords.map(k => k.replace(/\s+/g, '').toLowerCase());
    const coreCerts = job.certs.map(c => c.replace(/\s+/g, '').toLowerCase());
    const cleanCandExp = candExp.replace(/\[|\]|\(|\)/g, ''); 
